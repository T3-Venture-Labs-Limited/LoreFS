[Unit]
Description=LoreFS helper (version history, fast folders, health)
Documentation=https://github.com/T3-Venture-Labs-Limited/LoreFS
BindsTo=lorefs-mount.service
After=lorefs-mount.service

[Service]
Type=simple
ExecStart=%h/.local/bin/lorefs helper run
Restart=always
RestartSec=5

[Install]
WantedBy=lorefs-mount.service
